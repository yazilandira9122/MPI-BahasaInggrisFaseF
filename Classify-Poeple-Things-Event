    <!-- SYSTEM AUDIO & APPS JAVASCRIPT LOGIC -->
    <script>
        /* ==========================================================================
           1. GLOBAL APP STATE & USER DATA
           ========================================================================== */
        let studentData = {
            name: "Siswa SMK",
            school: "SMK Negeri 1",
            avatar: "👨‍🎓"
        };

        let currentSlide = 0;
        let quizScore = 0;
        let isQuizPassed = false;
        let userQuizAnswers = {};

        /* ==========================================================================
           2. WEB AUDIO API SYNTHESIZER (BGM & SFX WITHOUT EXTERNAL ASSETS)
           ========================================================================== */
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        let audioCtx = null;
        let isBgmOn = false;
        let isSfxOn = true;
        let bgmOscillator = null;
        let bgmGain = null;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new AudioCtx();
            }
        }

        function playSound(type) {
            if (!isSfxOn) return;
            initAudio();
            
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            const now = audioCtx.currentTime;

            if (type === 'click') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(600, now);
                osc.frequency.exponentialRampToValueAtTime(200, now + 0.05);
                gain.gain.setValueAtTime(0.15, now);
                gain.gain.linearRampToValueAtTime(0.01, now + 0.05);
                osc.start(now);
                osc.stop(now + 0.05);
            } else if (type === 'correct') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(523.25, now); // C5
                osc.frequency.setValueAtTime(659.25, now + 0.1); // E5
                osc.frequency.setValueAtTime(783.99, now + 0.2); // G5
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.linearRampToValueAtTime(0.01, now + 0.35);
                osc.start(now);
                osc.stop(now + 0.35);
            } else if (type === 'error') {
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(180, now);
                osc.frequency.setValueAtTime(140, now + 0.1);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.linearRampToValueAtTime(0.01, now + 0.25);
                osc.start(now);
                osc.stop(now + 0.25);
            }
        }

        function toggleBGM() {
            initAudio();
            isBgmOn = !isBgmOn;
            const btn = document.getElementById('btn-audio-bgm');

            if (isBgmOn) {
                btn.classList.add('bg-brand-600', 'text-white');
                btn.classList.remove('bg-white', 'text-slate-600');
                startAmbientBgm();
            } else {
                btn.classList.remove('bg-brand-600', 'text-white');
                btn.classList.add('bg-white', 'text-slate-600');
                stopAmbientBgm();
            }
            playSound('click');
        }

        function toggleSFX() {
            isSfxOn = !isSfxOn;
            const btn = document.getElementById('btn-audio-sfx');
            if (isSfxOn) {
                btn.classList.add('bg-brand-600', 'text-white');
                btn.classList.remove('bg-slate-300', 'text-slate-600');
            } else {
                btn.classList.remove('bg-brand-600', 'text-white');
                btn.classList.add('bg-slate-300', 'text-slate-600');
            }
        }

        function startAmbientBgm() {
            if (bgmOscillator) return;
            bgmOscillator = audioCtx.createOscillator();
            bgmGain = audioCtx.createGain();
            bgmOscillator.type = 'sine';
            bgmOscillator.frequency.setValueAtTime(220, audioCtx.currentTime); // Low soft pitch
            bgmGain.gain.setValueAtTime(0.02, audioCtx.currentTime); // Very quiet ambient
            bgmOscillator.connect(bgmGain);
            bgmGain.connect(audioCtx.destination);
            bgmOscillator.start();
        }

        function stopAmbientBgm() {
            if (bgmOscillator) {
                bgmOscillator.stop();
                bgmOscillator.disconnect();
                bgmOscillator = null;
            }
        }

