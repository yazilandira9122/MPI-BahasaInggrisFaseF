                                </label>
                                <label class="cursor-pointer">
                                    <input type="radio" name="avatar" value="🔧" class="peer hidden">
                                    <div class="w-12 h-12 rounded-xl border-2 border-slate-200 peer-checked:border-brand-600 peer-checked:bg-brand-50 flex items-center justify-center text-2xl transition">🔧</div>
                                </label>
