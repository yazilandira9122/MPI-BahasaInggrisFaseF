                            <i class="fa-solid fa-circle-info text-2xl text-brand-300"></i>
                            <div class="text-xs">
                                <p class="font-bold text-sm">Syarat Kelulusan Certificate</p>
                                <p class="text-brand-200">Sertifikat akan terbuka otomatis apabila skor Kuis Evaluasi Anda mencapai minimal 70 dari 100 point.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex justify-center pt-4">
                    <button onclick="navigateTo('screen-menu')" class="px-8 py-3 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl shadow-md transition flex items-center space-x-2">
                        <span>Lanjut ke Menu Utama</span>
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
