                </div>
                <div>
                    <h1 class="font-extrabold text-sm md:text-base text-brand-900 leading-tight">MPI ENGLISH XI SMK</h1>
                    <p class="text-xs text-brand-700 font-medium">Classify People, Things, Places & Events</p>
                </div>
            </div>

            <!-- Student Info Display & Sound Toggles -->
            <div class="flex items-center space-x-3">
