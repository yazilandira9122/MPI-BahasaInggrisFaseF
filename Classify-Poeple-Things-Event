            // Highlight selected card
            document.querySelectorAll('.sim-card').forEach(c => c.classList.remove('ring-2', 'ring-brand-500', 'bg-brand-50'));
            const cardEl = document.getElementById(`sim-card-${index}`);
            if (cardEl) cardEl.classList.add('ring-2', 'ring-brand-500', 'bg-brand-50');
        }

        function dropSimCard(targetCategory) {
            if (!selectedSimCard) return;
            playSound('click');

            const { index, text } = selectedSimCard;
            simUserAssignments[index] = targetCategory;

            // Move card visual element to target bin
            const bin = document.getElementById(`bin-${targetCategory}`);
            const cardEl = document.getElementById(`sim-card-${index}`);
            if (cardEl) {
                cardEl.classList.remove('ring-2', 'ring-brand-500', 'bg-brand-50');
                bin.appendChild(cardEl);
            }

            selectedSimCard = null;
        }

        function checkSimulation() {
            let correct = 0;
            simCardsData.forEach((item, index) => {
                if (simUserAssignments[index] === item.category) {
                    correct++;
                }
            });

            const feedback = document.getElementById('sim-score-feedback');
            if (correct === simCardsData.length) {
                playSound('correct');
                feedback.innerHTML = `<span class="text-brand-700">Perfect! ${correct}/${simCardsData.length} Kategori Tepat!</span>`;
            } else {
                playSound('error');
                feedback.innerHTML = `<span class="text-amber-700">Skor: ${correct}/${simCardsData.length}. Coba sesuaikan lagi card sorting Anda.</span>`;
            }
        }

        function resetSimulation() {
            playSound('click');
            initSimulation();
        }

        /* ==========================================================================
           6. EVALUATION QUIZ DATA & ENGINE (10 Interactive Multi-Type Questions)
           ========================================================================== */
        const quizQuestions = [
            {
                id: 1,
                type: "mcq",
                question: "Manakah di bawah ini yang seluruh kata-katanya diklasifikasikan ke dalam kategori 'PEOPLE'?",
                options: [
                    "A. Chef, Artisan, Volunteer",
                    "B. Smartphone, Craft, Camera",
                    "C. Museum, Town Square, Park",
                    "D. Festival, Concert, Ceremony",
                    "E. Chef, Souvenir, Museum"
                ],
                correct: 0,
                explanation: "Option A (Chef, Artisan, Volunteer) adalah kelompok individu/profesi yang semuanya termasuk dalam kategori PEOPLE."
            },
            {
                id: 2,
                type: "mcq",
                question: "Pilihlah Relative Pronoun yang tepat untuk kalimat: 'A doctor is a person _____ helps sick people.'",
                options: [
                    "A. which",
                    "B. where",
                    "C. who",
                    "D. when",
                    "E. whose"
                ],
                correct: 2,
                explanation: "Relative Pronoun 'WHO' digunakan secara khusus untuk menjelaskan Noun berjenis PEOPLE (doctor)."
            },
            {
                id: 3,
                type: "fill",
                question: "Lengkapilah isian rumpang berikut (Ketik huruf kecil): 'A museum is a place _____ historical items are displayed.'",
                correct: "where",
                explanation: "Tempat ('A museum / a place') dihubungkan menggunakan Relative Pronoun 'where'."
            },
            {
                id: 4,
                type: "dropdown",
                question: "Pilihlah kata berjenis 'EVENTS' dari opsi dropdown untuk melengkapi kalimat berikut:",
                sentencePrefix: "Every year, people attend the cultural ",
                options: ["monument", "festival", "artisan", "smartphone"],
                correct: "festival",
                explanation: "'Festival' merupakan contoh Noun kategori EVENTS (kejadian/perayaan)."
            },
            {
                id: 5,
                type: "checkbox",
                question: "Pilihlah SEMUA item di bawah ini yang termasuk dalam kategori 'THINGS' (Benda/Alat):",
                options: [
                    { text: "Handmade craft", isCorrect: true },
                    { text: "Digital camera", isCorrect: true },
                    { text: "Local chef", isCorrect: false },
                    { text: "Town square", isCorrect: false }
                ],
                explanation: "'Handmade craft' dan 'Digital camera' adalah benda mati (THINGS), sedangkan chef adalah People dan town square adalah Place."
            },
            {
                id: 6,
                type: "mcq",
                question: "Kalimat manakah yang menggunakan Relative Pronoun 'WHICH' secara tepat?",
                options: [
                    "A. A smartphone is a device which connects to the internet.",
                    "B. A technician is a person which repairs computers.",
                    "C. A park is a place which children play.",
                    "D. Festival is an event which people celebrate.",
                    "E. A doctor is a person which gives medicine."
                ],
                correct: 0,
                explanation: "Option A tepat karena 'smartphone / device' adalah THINGS yang dihubungkan dengan 'which'."
            },
            {
                id: 7,
                type: "matching",
                question: "Cocokkan Kategori di sebelah kiri dengan Contoh Noun yang tepat di sebelah kanan:",
                pairs: [
                    { category: "PEOPLE", item: "Volunteer" },
                    { category: "THINGS", item: "Souvenir" },
                    { category: "PLACES", item: "Workshop" },
                    { category: "EVENTS", item: "Exhibition" }
                ],
                explanation: "Matching: People-Volunteer, Things-Souvenir, Places-Workshop, Events-Exhibition."
            },
            {
                id: 8,
                type: "mcq",
                question: "Berdasarkan teks 'Cultural Festivals', apakah fungsi dari 'friendly volunteers'?",
                options: [
                    "A. Cooking authentic dishes for visitors",
                    "B. Helping visitors navigate the venue and answering questions",
                    "C. Selling handmade crafts in market booths",
                    "D. Presenting traditional dances on stage",
                    "E. Taking photos with digital cameras"
                ],
                correct: 1,
                explanation: "Sesuai paragraf 2 teks bacaan: 'Friendly volunteers ... helping visitors navigate the venue and answering their questions.'"
            },
            {
                id: 9,
                type: "dropdown",
                question: "Pilihlah Relative Pronoun yang tepat untuk waktu/event:",
                sentencePrefix: "New Year's Eve is an occasion ",
                options: ["who", "where", "when", "which"],
                sentenceSuffix: " people celebrate the start of a year.",
                correct: "when",
                explanation: "Relative Pronoun 'WHEN' digunakan untuk menerangkan waktu atau peristiwa (EVENTS)."
            },
            {
                id: 10,
                type: "mcq",
                question: "Kata sifat (Adjectives) manakah yang paling cocok untuk mendeskripsikan kategori 'PLACES' industri SMK?",
                options: [
                    "A. Spacious & Historic",
                    "B. Polite & Skilled",
                    "C. Fragile & Durable",
                    "D. Annual & Memorable",
                    "E. Energetic & Kind"
                ],
                correct: 0,
                explanation: "'Spacious' (luas) dan 'Historic' (bersejarah) adalah kata sifat deskriptif untuk tempat/lokasi (PLACES)."
            }
        ];

        let currentQuestionIdx = 0;

        function renderQuestion() {
            const container = document.getElementById('quiz-body');
            const q = quizQuestions[currentQuestionIdx];
            document.getElementById('quiz-num-display').innerText = currentQuestionIdx + 1;

            let html = `
                <div class="space-y-4 max-w-3xl mx-auto bg-white p-6 rounded-3xl border border-slate-200 shadow-sm">
                    <span class="text-[10px] font-extrabold uppercase px-2.5 py-1 bg-amber-100 text-amber-900 rounded-full">
                        Tipe Soal: ${q.type.toUpperCase()}
                    </span>
                    <h3 class="text-base md:text-lg font-bold text-slate-800 leading-snug">${q.question}</h3>
            `;

            // Type 1: MCQ (5 Options A-E)
            if (q.type === 'mcq') {
                html += `<div class="space-y-2 pt-2">`;
                q.options.forEach((opt, idx) => {
                    const checked = userQuizAnswers[q.id] === idx ? 'checked' : '';
                    html += `
                        <label class="flex items-center space-x-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition">
                            <input type="radio" name="quiz-opt" value="${idx}" ${checked} onchange="saveAnswer(${q.id}, ${idx})" class="w-4 h-4 text-brand-600 focus:ring-brand-500">
                            <span class="text-xs text-slate-700 font-medium">${opt}</span>
                        </label>
                    `;
                });
                html += `</div>`;
            }

            // Type 2: Fill-in-the-blank Text Input
            else if (q.type === 'fill') {
                const val = userQuizAnswers[q.id] || '';
                html += `
                    <div class="pt-2">
                        <input type="text" value="${val}" onchange="saveAnswer(${q.id}, this.value.trim().toLowerCase())" placeholder="Ketik jawaban Anda di sini..." class="w-full p-3 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none">
                    </div>
                `;
            }

            // Type 3: Rumpang Dropdown
            else if (q.type === 'dropdown') {
                const val = userQuizAnswers[q.id] || '';
                html += `
                    <div class="pt-2 flex flex-wrap items-center gap-2 text-xs text-slate-700 font-medium">
                        <span>${q.sentencePrefix || ''}</span>
                        <select onchange="saveAnswer(${q.id}, this.value)" class="p-2.5 rounded-xl border border-slate-300 font-bold text-brand-700 focus:ring-2 focus:ring-amber-500">
                            <option value="">-- Pilih Jawaban --</option>
                            ${q.options.map(opt => `<option value="${opt}" ${val === opt ? 'selected' : ''}>${opt}</option>`).join('')}
                        </select>
                        <span>${q.sentenceSuffix || ''}</span>
                    </div>
                `;
            }

            // Type 4: Checkbox Multi-Select
            else if (q.type === 'checkbox') {
                const selectedArr = userQuizAnswers[q.id] || [];
                html += `<div class="space-y-2 pt-2">`;
                q.options.forEach((opt, idx) => {
                    const checked = selectedArr.includes(idx) ? 'checked' : '';
                    html += `
                        <label class="flex items-center space-x-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition">
                            <input type="checkbox" ${checked} onchange="toggleCheckboxAnswer(${q.id}, ${idx})" class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500">
                            <span class="text-xs text-slate-700 font-medium">${opt.text}</span>
                        </label>
                    `;
                });
                html += `</div>`;
            }

            // Type 5: Drag & Drop Matching (Static Selector fallback for robust mobile)
            else if (q.type === 'matching') {
                const matches = userQuizAnswers[q.id] || {};
                html += `<div class="grid gap-2 pt-2">`;
                q.pairs.forEach((pair, idx) => {
                    const val = matches[pair.category] || '';
                    html += `
                        <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-xs">
                            <span class="font-bold text-brand-800">${pair.category}</span>
                            <i class="fa-solid fa-arrow-right text-slate-400"></i>
                            <select onchange="saveMatchingAnswer(${q.id}, '${pair.category}', this.value)" class="p-1.5 rounded-lg border border-slate-300 font-semibold text-slate-700">
                                <option value="">-- Pilih Match --</option>
                                ${q.pairs.map(p => `<option value="${p.item}" ${val === p.item ? 'selected' : ''}>${p.item}</option>`).join('')}
                            </select>
                        </div>
                    `;
                });
                html += `</div>`;
            }

            html += `</div>`;
            container.innerHTML = html;

            // Nav controls
            document.getElementById('btn-quiz-prev').style.visibility = currentQuestionIdx === 0 ? 'hidden' : 'visible';
            if (currentQuestionIdx === quizQuestions.length - 1) {
                document.getElementById('btn-quiz-next').classList.add('hidden');
                document.getElementById('btn-quiz-submit').classList.remove('hidden');
            } else {
                document.getElementById('btn-quiz-next').classList.remove('hidden');
                document.getElementById('btn-quiz-submit').classList.add('hidden');
            }
        }

        function saveAnswer(qId, val) {
            playSound('click');
            userQuizAnswers[qId] = val;
        }

        function toggleCheckboxAnswer(qId, idx) {
            playSound('click');
            if (!userQuizAnswers[qId]) userQuizAnswers[qId] = [];
            const arr = userQuizAnswers[qId];
            const pos = arr.indexOf(idx);
            if (pos > -1) arr.splice(pos, 1);
            else arr.push(idx);
        }

        function saveMatchingAnswer(qId, category, selectedItem) {
            playSound('click');
            if (!userQuizAnswers[qId]) userQuizAnswers[qId] = {};
            userQuizAnswers[qId][category] = selectedItem;
        }

        function nextQuestion() {
            playSound('click');
            if (currentQuestionIdx < quizQuestions.length - 1) {
                currentQuestionIdx++;
                renderQuestion();
            }
        }

        function prevQuestion() {
            playSound('click');
            if (currentQuestionIdx > 0) {
                currentQuestionIdx--;
                renderQuestion();
            }
        }

        /* ==========================================================================
           7. QUIZ EVALUATION & AUTOMATIC EXPLANATION GENERATOR
           ========================================================================== */
        function submitQuiz() {
            playSound('click');
            let totalCorrect = 0;

            quizQuestions.forEach(q => {
                const ans = userQuizAnswers[q.id];

                if (q.type === 'mcq' && ans === q.correct) totalCorrect++;
                else if (q.type === 'fill' && ans === q.correct) totalCorrect++;
                else if (q.type === 'dropdown' && ans === q.correct) totalCorrect++;
                else if (q.type === 'checkbox') {
                    const correctIndices = q.options.map((o, i) => o.isCorrect ? i : null).filter(i => i !== null);
                    const userIndices = ans || [];
                    if (JSON.stringify(correctIndices.sort()) === JSON.stringify(userIndices.sort())) {
                        totalCorrect++;
                    }
                } else if (q.type === 'matching') {
                    let allMatched = true;
                    q.pairs.forEach(p => {
                        if (!ans || ans[p.category] !== p.item) allMatched = false;
                    });
                    if (allMatched) totalCorrect++;
                }
            });

            quizScore = Math.round((totalCorrect / quizQuestions.length) * 100);
            isQuizPassed = quizScore >= 70;

            // Render Results Header
            document.getElementById('final-score-val').innerText = quizScore;
            
            let predicate = 'C';
            if (quizScore >= 90) predicate = 'A (Excellent)';
            else if (quizScore >= 80) predicate = 'B (Very Good)';
            else if (quizScore >= 70) predicate = 'C (Good)';
            else predicate = 'D (Need Practice)';

            document.getElementById('final-predicate-val').innerText = predicate;

            const statusText = document.getElementById('result-status-text');
            if (isQuizPassed) {
                statusText.innerText = "Selamat! Anda telah LULUS kuis evaluasi ini. Sertifikat Anda sudah terbuka!";
                document.getElementById('btn-cert-from-result').classList.remove('hidden');
                unlockCertificateTile();
            } else {
                statusText.innerText = "Nilai Anda belum memenuhi batas kelulusan (Min. 70). Silahkan pelajari materi dan coba lagi.";
                document.getElementById('btn-cert-from-result').classList.add('hidden');
            }

            // Render Automatic Explanation List
            const expList = document.getElementById('quiz-explanation-list');
            expList.innerHTML = '';
            quizQuestions.forEach((q, idx) => {
                const item = document.createElement('div');
                item.className = "bg-slate-50 p-3 rounded-xl border border-slate-200 text-xs space-y-1";
                item.innerHTML = `
                    <div class="font-bold text-slate-800">Soal ${idx + 1}: ${q.question}</div>
                    <div class="text-brand-700 font-semibold">💡 Pembahasan: ${q.explanation}</div>
                `;
                expList.appendChild(item);
            });

            navigateTo('screen-quiz-result');
        }

        function unlockCertificateTile() {
            const badge = document.getElementById('cert-lock-badge');
            if (badge) {
                badge.className = "inline-flex items-center space-x-1 bg-amber-400 text-slate-950 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider";
                badge.innerHTML = `<i class="fa-solid fa-lock-open mr-1"></i> Terbuka (Lulus)`;
            }
        }

        /* ==========================================================================
           8. CERTIFICATE GENERATION & PRINT
           ========================================================================== */
        function openCertificateScreen() {
            if (!isQuizPassed) {
                playSound('error');
                alert("Sertifikat masih terkunci. Anda harus menyelesaikan Kuis Evaluasi dengan skor minimal 70 untuk membuka Sertifikat.");
                return;
            }

            playSound('correct');

            // Populate Certificate Data
            document.getElementById('cert-student-name').innerText = studentData.name;
            document.getElementById('cert-school-name').innerText = studentData.school;
            document.getElementById('cert-score-display').innerText = `${quizScore} / 100`;

            const now = new Date();
            const dateStr = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
            document.getElementById('cert-date').innerText = dateStr;

            navigateTo('screen-certificate');
        }

        /* ==========================================================================
           9. REFLECTION LOGIC
           ========================================================================== */
        function saveReflection() {
            playSound('correct');
            alert("Terima kasih! Catatan refleksi diri Anda telah berhasil disimpan dalam sesi belajar ini.");
            navigateTo('screen-menu');
        }

        /* ==========================================================================
           10. APP INITIALIZATION ON WINDOW LOAD
           ========================================================================== */
        window.onload = function() {
            renderSlide();
            initSimulation();
            renderQuestion();
        };
    </script>
